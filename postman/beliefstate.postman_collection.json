{
  "info": {
    "_postman_id": "b65fe31f-76a6-4b94-9eb3-b97a158a5d9b",
    "name": "BeliefState: investor research API",
    "description": "Free discovery and typed tool contracts. No credentials or payment signer. Research purchases require separately authorized account or wallet access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://beliefstate.ai",
      "type": "string"
    },
    {
      "key": "ticker",
      "value": "NVDA",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Research catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-BeliefState-Usage",
            "value": "test"
          }
        ],
        "url": "{{baseUrl}}/v1/research",
        "description": "Free operation schemas and prices."
      }
    },
    {
      "name": "OpenAPI",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-BeliefState-Usage",
            "value": "test"
          }
        ],
        "url": "{{baseUrl}}/openapi.json",
        "description": "Current REST contract."
      }
    },
    {
      "name": "MCP server cards",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-BeliefState-Usage",
            "value": "test"
          }
        ],
        "url": "{{baseUrl}}/.well-known/mcp/server-cards.json",
        "description": "Account and wallet inventory."
      }
    },
    {
      "name": "Find company coverage",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-BeliefState-Usage",
            "value": "test"
          }
        ],
        "url": "{{baseUrl}}/v1/tickers?q={{ticker}}",
        "description": "Free company/ticker discovery."
      }
    },
    {
      "name": "SEC filing news",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-BeliefState-Usage",
            "value": "test"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/research/news",
        "description": "Free official SEC filing metadata; no account, payment or model call.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"{{ticker}}\",\n  \"limit\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
